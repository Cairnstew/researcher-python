# researcher-python configuration
#
# Copy this file to `.env` in the working directory — python-dotenv loads it
# automatically — or export the variables directly into your shell. Real
# environment variables always win over values in `.env`.
#
# Everything below is optional. Empty value = "not configured".

# Contact email. Required by NCBI for E-utilities, and expected by Crossref's
# and Unpaywall's polite pool (Crossref 429s anonymous callers aggressively).
# Any address you own works.
RESEARCHER_EMAIL=

# Optional, but in practice you want one: keyless Semantic Scholar traffic is
# rate-limited to roughly one request/second and often returns HTTP 429 from
# shared IPs. Raises the quota. Create one at https://www.semanticscholar.org/product/api
RESEARCHER_SEMANTIC_SCHOLAR_API_KEY=

# Optional. Anonymous OpenAlex search intermittently answers HTTP 503 while it
# is paused for a cluster; a free key removes that mode and lifts the limit.
# Request one at https://docs.openalex.org/how-to-use-the-api/get-api-keys
RESEARCHER_OPENALEX_API_KEY=

# Optional. Raises NCBI E-utilities from 3 to 10 requests/second.
# Create one with an NCBI account: https://www.ncbi.nlm.nih.gov/account/
RESEARCHER_NCBI_API_KEY=

# Where `download` writes PDFs. Created on demand.
RESEARCHER_OUTPUT_DIR=downloads

# Package log level: DEBUG | INFO | WARNING | ERROR.
# (The CLI also accepts `--log-level`, which overrides this for one run.)
RESEARCHER_LOG_LEVEL=INFO

# Per-source cap on a single search. Integer >= 1.
RESEARCHER_MAX_RESULTS=50

# Extra attempts after the first, allowed only when a source answers 429.
# Integer >= 0; 0 disables retrying. Sleeps min(Retry-After or 2, 10) seconds.
RESEARCHER_RETRIES=1

# Per-request socket timeout in seconds. A positive number.
RESEARCHER_TIMEOUT=30.0
