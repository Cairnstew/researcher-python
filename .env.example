# Copy to .env — never commit the real one.
#
# researcher-python currently needs NO API keys: the package is a scaffold
# and the defaults below are placeholders.  When a real data source lands,
# name its credentials in the house style (e.g. RESEARCHER_API_KEY) and
# document them here.

# Logging level for the package logger (DEBUG|INFO|WARNING|ERROR).
# RESEARCHER_LOG_LEVEL=INFO

# Where pulled/derived artifacts are written (relative to the working dir).
# RESEARCHER_OUTPUT_DIR=./out
