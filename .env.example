# researcher-python configuration
#
# Copy this file to `./.env` (repo-local) or to
# `~/.config/researcher-python/.env` (global, so a server launched from any
# directory finds it) — python-dotenv loads the first match automatically.
# `RESEARCHER_ENV_FILE` and `$RESEARCHER_HOME/.env` take precedence; real
# environment variables always win over values in `.env`.
#
# Everything below is optional. Empty value = "not configured".

# Contact email. Required by NCBI for E-utilities, and expected by Crossref's
# and Unpaywall's polite pool (Crossref 429s anonymous callers aggressively).
# Any address you own works.
RESEARCHER_EMAIL=

# Optional, but in practice you want one: keyless Semantic Scholar traffic is
# rate-limited to roughly one request/second and often returns HTTP 429 from
# shared IPs. Raises the quota. Create one at https://www.semanticscholar.org/product/api
RESEARCHER_SEMANTIC_SCHOLAR_API_KEY=

# Optional. Anonymous OpenAlex search intermittently answers HTTP 503 while it
# is paused for a cluster; a free key removes that mode and lifts the limit.
# Request one at https://docs.openalex.org/how-to-use-the-api/get-api-keys
RESEARCHER_OPENALEX_API_KEY=

# Optional. Raises NCBI E-utilities from 3 to 10 requests/second.
# Create one with an NCBI account: https://www.ncbi.nlm.nih.gov/account/
RESEARCHER_NCBI_API_KEY=

# Optional. Stack Exchange API key for the web-source framework
# (Stack Overflow etc.). Keyless traffic shares a 300/day anonymous IP
# quota; a key raises the application quota. Register an app at
# https://stackapps.com/apps/oauth/register
RESEARCHER_STACKEXCHANGE_KEY=

# Required for the Reddit web source only. Reddit closes its anonymous JSON
# endpoints (HTTP 403), so web_search(source="reddit") needs a registered
# OAuth app. Register one (free) at https://www.reddit.com/prefs/apps —
# "script" type, the client id is the short code under the app name, the
# secret is the "secret" value.
RESEARCHER_REDDIT_CLIENT_ID=
RESEARCHER_REDDIT_CLIENT_SECRET=

# Where `download` writes PDFs. Created on demand.
RESEARCHER_OUTPUT_DIR=downloads

# ── Workspaces (state + provenance) ──────────────────────────────────────────
# Root for named workspaces. `Workspace("cw1")` resolves to $RESEARCHER_HOME/cw1.
# Absolute workspace paths ignore this. When unset, a relative path resolves
# against the process cwd (pre-workspace behaviour).
RESEARCHER_HOME=

# Default workspace for tools that omit one (CLI --workspace still wins, and an
# MCP open_workspace call overrides it for the session). Relative paths resolve
# under RESEARCHER_HOME.
RESEARCHER_WORKSPACE=

# Explicit absolute .env path. A globally registered MCP server has no useful
# cwd, so this (or $RESEARCHER_HOME/.env) is how it finds credentials.
# Missing explicit file is an error; unset falls back to
# $RESEARCHER_HOME/.env, ~/.config/researcher-python/.env, then ./.env.
RESEARCHER_ENV_FILE=

# Package log level: DEBUG | INFO | WARNING | ERROR.
# (The CLI also accepts `--log-level`, which overrides this for one run.)
RESEARCHER_LOG_LEVEL=INFO

# Per-source cap on a single search. Integer >= 1.
RESEARCHER_MAX_RESULTS=50

# Extra attempts after the first, allowed only when a source answers 429.
# Integer >= 0; 0 disables retrying. Sleeps min(Retry-After or 2, 10) seconds.
RESEARCHER_RETRIES=1

# Per-request socket timeout in seconds. A positive number.
RESEARCHER_TIMEOUT=30.0

# Backfill missing citation counts/abstracts from OpenAlex after a search.
# Only runs when openalex participated in that search (an explicit --source
# stays authoritative). Boolean: 1/0, true/false, yes/no.
RESEARCHER_ENRICH=true
